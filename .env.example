# Copy to .env on your own VPS. Change all the secrets before first launch.
MPOL_DOMAIN=chat.example.com
MPOL_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
MPOL_RECOVERY_SECRET=REPLACE_WITH_LONG_RANDOM_64_CHAR_SECRET
# Optional SMTP, required for email verification and recovery:
MPOL_SMTP_HOST=
MPOL_SMTP_PORT=587
MPOL_SMTP_USER=
MPOL_SMTP_PASSWORD=
MPOL_SMTP_FROM=

# Public MPOL online mode: set this in Render environment variables, not in GitHub.
# A full PostgreSQL URI from Neon, ending in ?sslmode=require (if not already specified):
# MPOL_DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@<db-host>/<db-name>?sslmode=require
# Fails startup instead of silently using a temporary local SQLite database:
# MPOL_REQUIRE_PERSISTENT_DB=1
# Optional: MPOL_EPHEMERAL_STORAGE=0

# Optional WebRTC relay for calls across different internet/mobile networks (configure in Render env):
# MPOL_TURN_URLS=turn:relay.example.com:3478?transport=udp,turns:relay.example.com:5349?transport=tcp
# MPOL_TURN_SECRET=YOUR_PRIVATE_COTURN_STATIC_AUTH_SECRET
# MPOL_TURN_TTL=3600
# Alternative TURN provider with static credentials (less safe than short-lived):
# MPOL_TURN_USERNAME=
# MPOL_TURN_PASSWORD=
