{
  "name": "mpol-messenger-desktop",
  "productName": "Mpol Messenger",
  "version": "3.8.1",
  "description": "Native Windows desktop client for existing MPOL Messenger online accounts",
  "main": "main.cjs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "lint": "node --check main.cjs && node --check lib/security.cjs && node --check lib/media-permissions.cjs && node --check lib/speech.cjs && node --check lib/updater.cjs && node --check preload.cjs && node --check server-settings.js && node --check offline.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.mpol.messenger.desktop",
    "productName": "Mpol Messenger",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "server-settings.html",
      "server-settings.js",
      "offline.html",
      "lib/**/*",
      "package.json",
      "offline.js"
    ],
    "extraResources": [
      {
        "from": "../MpolMessenger.ico",
        "to": "mpol.ico"
      },
      {
        "from": "speech-bundle",
        "to": "speech",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "icon": "../MpolMessenger.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MpolMessenger.exe",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "MpolMessenger.exe",
      "requestExecutionLevel": "user"
    },
    "publish": null,
    "nsis": {
      "artifactName": "MpolMessengerSetup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mpol Messenger",
      "uninstallDisplayName": "Mpol Messenger",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
