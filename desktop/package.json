{
  "name": "mpol-messenger-desktop",
  "productName": "Mpol Messenger",
  "version": "2.5.0",
  "description": "Native Windows desktop client for existing MPOL Messenger online accounts",
  "main": "main.cjs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "lint": "node --check main.cjs && node --check lib/security.cjs && node --check lib/updater.cjs",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.mpol.messenger.desktop",
    "productName": "Mpol Messenger",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "offline.html",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../MpolMessenger.ico",
        "to": "mpol.ico"
      }
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "icon": "../MpolMessenger.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MpolMessenger.exe",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "MpolMessenger.exe",
      "requestExecutionLevel": "user"
    },
    "publish": null
  }
}
